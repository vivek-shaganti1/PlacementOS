# Supabase project settings (Project Settings -> API Keys). Only the publishable key belongs here;
# never put the secret / service_role key in a VITE_ variable, it would ship to the browser.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Optional: address behind the pricing buttons on the landing page.
VITE_SALES_EMAIL=

# Server-only. Set these in Vercel / .env.local, never commit a real value.
SUPABASE_SECRET_KEY=
GROQ_API_KEY=
CONNECT_PROOF_SECRET=

# Server-only and optional.
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODELS=openai/gpt-oss-20b,qwen/qwen3.8-27b
GITHUB_TOKEN=
# Fallbacks for the two VITE_ names above, for server code only.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

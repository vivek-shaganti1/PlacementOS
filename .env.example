# Supabase project settings (Project Settings -> API Keys). Only the publishable key belongs here;
# never put the secret / service_role key in a VITE_ variable, it would ship to the browser.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Preview or staging builds only: set to true so the browser talks to VITE_SUPABASE_URL directly instead of through
# this site's /supabase proxy (vercel.json points that proxy at production).
VITE_SUPABASE_DIRECT=

# Optional: address behind the pricing buttons on the landing page.
VITE_SALES_EMAIL=

# Server-only. Set these in Vercel / .env.local, never commit a real value.
SUPABASE_SECRET_KEY=
GROQ_API_KEY=
CONNECT_PROOF_SECRET=

# Server-only and optional.
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODELS=openai/gpt-oss-20b,qwen/qwen3.8-27b
# Off-campus job search (Adzuna, free key from developer.adzuna.com). Without both, the search card stays hidden.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
GITHUB_TOKEN=
# Live company research (docs/RESEARCH.md). The secret is shared with the database's scheduler (Vault). A web search key
# is optional: Tavily (1,000 free searches a month) is tried first, then Brave.
RESEARCH_WORKER_SECRET=
TAVILY_API_KEY=
BRAVE_SEARCH_API_KEY=
# Fallbacks for the two VITE_ names above, for server code only.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Server-only and optional: error reports, and a switch that pauses every AI feature.
SENTRY_DSN=
AI_DISABLED=

# Browser, optional: error reports, and the published privacy contact (a named person and email).
VITE_SENTRY_DSN=
VITE_GRIEVANCE_CONTACT=
